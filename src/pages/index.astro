---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllGames } from '../lib/games';

export const prerender = true;

const games = await getAllGames(getDatabase());
const categories = [...new Map(
  games
    .filter((game) => game.category !== null)
    .map((game) => [game.category!.id, game.category!]),
).values()].sort((a, b) => a.name.localeCompare(b.name));
const publishers = [...new Map(
  games
    .filter((game) => game.publisher !== null)
    .map((game) => [game.publisher!.id, game.publisher!]),
).values()].sort((a, b) => a.name.localeCompare(b.name));
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <>
          <form
            id="game-filters"
            class="mb-8 grid gap-4 rounded-xl border border-slate-700 bg-slate-800/60 p-5 sm:grid-cols-[1fr_1fr_auto] sm:items-end"
            data-testid="game-filters"
          >
            <div>
              <label for="category-filter" class="mb-2 block text-sm font-medium text-slate-200">
                Categories
              </label>
              <select
                id="category-filter"
                name="categories"
                multiple
                size={Math.min(Math.max(categories.length, 2), 5)}
                class="min-h-24 w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                data-testid="category-filter"
              >
                {categories.map((category) => (
                  <option value={category.id}>{category.name}</option>
                ))}
              </select>
              <p class="mt-1 text-xs text-slate-400">Use Ctrl or Command to select multiple.</p>
            </div>

            <div>
              <label for="publisher-filter" class="mb-2 block text-sm font-medium text-slate-200">
                Publisher
              </label>
              <select
                id="publisher-filter"
                name="publisher"
                class="w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                data-testid="publisher-filter"
              >
                <option value="">All publishers</option>
                {publishers.map((publisher) => (
                  <option value={publisher.id}>{publisher.name}</option>
                ))}
              </select>
            </div>

            <button
              type="reset"
              class="rounded-lg border border-slate-600 px-4 py-2 font-medium text-slate-200 transition-colors hover:bg-slate-700 focus:ring-2 focus:ring-blue-500 focus:outline-none"
              data-testid="reset-filters"
            >
              Clear filters
            </button>
          </form>

          <p class="sr-only" role="status" aria-live="polite" data-testid="filter-results-status"></p>
          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3" data-testid="games-grid">
            {games.map((game) => <GameCard game={game} />)}
          </div>
          <div class="hidden" data-testid="filtered-empty-state" role="status" aria-live="polite">
            <EmptyState text="No games match these filters." />
          </div>
        </>
      )}
    </div>
  </div>
</Layout>

<script>
  const filterForm = document.querySelector<HTMLFormElement>('#game-filters');
  const categoryFilter = document.querySelector<HTMLSelectElement>('#category-filter');
  const publisherFilter = document.querySelector<HTMLSelectElement>('#publisher-filter');
  const cards = [...document.querySelectorAll<HTMLElement>('[data-testid="game-card"]')];
  const emptyState = document.querySelector<HTMLElement>('[data-testid="filtered-empty-state"]');
  const status = document.querySelector<HTMLElement>('[data-testid="filter-results-status"]');

  const applyFilters = () => {
    if (!categoryFilter || !publisherFilter || !emptyState || !status) return;

    const categoryIds = new Set([...categoryFilter.selectedOptions].map((option) => option.value));
    const publisherId = publisherFilter.value;
    let visibleCount = 0;

    cards.forEach((card) => {
      const categoryMatches = categoryIds.size === 0 || categoryIds.has(card.dataset.categoryId ?? '');
      const publisherMatches = publisherId === '' || card.dataset.publisherId === publisherId;
      const matches = categoryMatches && publisherMatches;
      card.hidden = !matches;
      if (matches) visibleCount += 1;
    });

    emptyState.classList.toggle('hidden', visibleCount > 0);
    status.textContent = `${visibleCount} ${visibleCount === 1 ? 'game' : 'games'} shown`;
  };

  filterForm?.addEventListener('change', applyFilters);
  filterForm?.addEventListener('reset', () => requestAnimationFrame(applyFilters));
  applyFilters();
</script>
